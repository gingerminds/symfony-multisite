{#
 # Sites card of the core user form (user_form_sidebar include): the fields of
 # UserSitesTypeExtension, only added for the users allowed to assign sites.
 #}
{% trans_default_domain 'GingermindsMultisite' %}
{% if form.sites is defined %}
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex align-items-center py-3">
            <h5 class="card-title mb-0"><i class="bi bi-globe2 me-1 text-primary"></i> {{ 'user_sites.title'|trans }}</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {% if form.all_sites is defined %}
                    {{ form_row(form.all_sites, {size_columns: 12, help: 'user_sites.help.all_sites'}) }}
                {% endif %}
                {{ form_row(form.sites, {size_columns: 12}) }}
            </div>
        </div>
    </div>
{% endif %}
